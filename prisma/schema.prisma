generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuizSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model AppSetting {
  key   String @id
  value String
}

model User {
  id                  String             @id @default(uuid()) @db.Uuid
  email               String?            @unique
  passwordHash        String?
  displayName         String             @unique @db.VarChar(32)
  isAdmin             Boolean            @default(false)
  canEditQuestions    Boolean            @default(false)
  isMuted             Boolean            @default(false)
  hideScore           Boolean            @default(false)
  nameColor           String?            @db.VarChar(16)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  // last heartbeat from an open ST0NE QUIZ tab — drives the "online" list
  lastSeenAt          DateTime?
  quizSessions        QuizSession[]
  questionStats       UserQuestionStat[]
  chatMessages        ChatMessage[]
  questionReports     QuestionReport[]
  duelsAsHost         Duel[]             @relation("DuelHost")
  duelsAsGuest        Duel[]             @relation("DuelGuest")
  towerGamesAsHost    TowerGame[]        @relation("TowerHost")
  towerSeats          TowerPlayer[]
  carciumaGamesAsHost CarciumaGame[]     @relation("CarciumaHost")
  carciumaSeats       CarciumaPlayer[]   @relation("CarciumaSeats")
  questionEdits       QuestionEdit[]

  @@index([lastSeenAt])
}

enum DuelStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

// A 1v1 match: 10 rounds (6 grila + 4 rapide). The question plan is frozen at
// creation (shuffled grila options included) so both players see the same
// question in the same order. Rounds resolve server-side; see lib/duel.ts.
model Duel {
  id             String       @id @default(uuid()) @db.Uuid
  hostId         String       @db.Uuid
  guestId        String?      @db.Uuid
  status         DuelStatus   @default(WAITING)
  hostScore      Int          @default(0)
  guestScore     Int          @default(0)
  currentRound   Int          @default(0)
  roundStartedAt DateTime?
  plan           Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  completedAt    DateTime?
  host           User         @relation("DuelHost", fields: [hostId], references: [id], onDelete: Cascade)
  guest          User?        @relation("DuelGuest", fields: [guestId], references: [id], onDelete: SetNull)
  answers        DuelAnswer[]

  @@index([hostId])
  @@index([guestId])
  @@index([status, createdAt])
}

model DuelAnswer {
  id                  String   @id @default(uuid()) @db.Uuid
  duelId              String   @db.Uuid
  userId              String   @db.Uuid
  round               Int
  questionId          String   @db.Uuid
  selectedOptionId    String?  @db.Uuid
  submittedAnswer     String?
  isCorrect           Boolean  @default(false)
  score               Int?
  elapsedMilliseconds Int
  answeredAt          DateTime @default(now())
  duel                Duel     @relation(fields: [duelId], references: [id], onDelete: Cascade)

  @@unique([duelId, userId, round])
  @@index([duelId])
}

// TURNUL — 8-player ladder siege, 9 rounds. Everyone climbs a tower face with
// their own ladder; each answer earns points and the round's points become
// rungs. After round 8 the lowest score falls off the ladder, and round 9
// crowns the player who reaches the top. Rounds resolve server-side (see
// lib/tower.ts); bots fill empty seats so a single player can start.
enum TowerStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model TowerGame {
  id             String        @id @default(uuid()) @db.Uuid
  hostId         String        @db.Uuid
  status         TowerStatus   @default(WAITING)
  plan           Json
  currentRound   Int           @default(0)
  roundStartedAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?
  winnerId       String?       @db.Uuid
  host           User          @relation("TowerHost", fields: [hostId], references: [id], onDelete: Cascade)
  players        TowerPlayer[]
  answers        TowerAnswer[]
  rocks          TowerRock[]

  @@index([status, createdAt])
  @@index([hostId])
}

model TowerPlayer {
  id         String        @id @default(uuid()) @db.Uuid
  gameId     String        @db.Uuid
  userId     String?       @db.Uuid
  name       String        @db.VarChar(32)
  isBot      Boolean       @default(false)
  seat       Int
  score      Int           @default(0)
  rungs      Int           @default(0)
  eliminated Boolean       @default(false)
  fellRound  Int?
  game       TowerGame     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  answers    TowerAnswer[]

  @@unique([gameId, seat])
  @@index([gameId])
}

model TowerAnswer {
  id                  String      @id @default(uuid()) @db.Uuid
  gameId              String      @db.Uuid
  playerId            String      @db.Uuid
  round               Int
  questionId          String      @db.Uuid
  selectedOptionId    String?     @db.Uuid
  isCorrect           Boolean     @default(false)
  score               Int         @default(0)
  rungs               Int         @default(0)
  elapsedMilliseconds Int         @default(0)
  answeredAt          DateTime    @default(now())
  game                TowerGame   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player              TowerPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([gameId, playerId, round])
  @@index([gameId])
}

model ChatMessage {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  authorName String   @db.VarChar(32)
  text       String   @db.VarChar(2000)
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model Category {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique @db.VarChar(100)
  slug      String     @unique @db.VarChar(100)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  questions Question[]
}

model Question {
  id             String             @id @default(uuid()) @db.Uuid
  categoryId     String?            @db.Uuid
  prompt         String
  explanation    String?
  difficulty     Int                @default(1)
  isPublished    Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  category       Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  options        QuestionOption[]
  sessionAnswers SessionAnswer[]
  userStats      UserQuestionStat[]
  reports        QuestionReport[]
  edits          QuestionEdit[]

  @@index([categoryId, isPublished])
}

// Who touched a question, when and what changed — the admin "who edited this?"
// trail. editorName and prompt are SNAPSHOTS: they survive a rename, and the
// trail survives the question being deleted (questionId goes null, the row stays).
model QuestionEdit {
  id         String    @id @default(uuid()) @db.Uuid
  questionId String?   @db.Uuid
  editorId   String?   @db.Uuid
  editorName String    @db.VarChar(32)
  action     String    @db.VarChar(16) // create | import | edit | publish | unpublish | delete
  prompt     String    @db.VarChar(1000)
  summary    String?   @db.VarChar(300)
  createdAt  DateTime  @default(now())
  question   Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  editor     User?     @relation(fields: [editorId], references: [id], onDelete: SetNull)

  @@index([questionId, createdAt])
  @@index([editorId, createdAt])
  @@index([createdAt])
}

model QuestionReport {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @db.Uuid
  userId     String?  @db.Uuid
  note       String   @db.VarChar(500)
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([questionId])
}

model QuestionOption {
  id              String          @id @default(uuid()) @db.Uuid
  questionId      String          @db.Uuid
  text            String
  position        Int
  isCorrect       Boolean         @default(false)
  question        Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedAnswers SessionAnswer[] @relation("SelectedOption")

  @@unique([questionId, position])
}

model QuizSession {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String?           @db.Uuid
  status        QuizSessionStatus @default(IN_PROGRESS)
  questionCount Int
  correctCount  Int               @default(0)
  startedAt     DateTime          @default(now())
  completedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  answers       SessionAnswer[]

  @@index([userId, completedAt])
}

model SessionAnswer {
  id                  String          @id @default(uuid()) @db.Uuid
  quizSessionId       String          @db.Uuid
  questionId          String          @db.Uuid
  selectedOptionId    String?         @db.Uuid
  submittedAnswer     String?
  isCorrect           Boolean
  elapsedMilliseconds Int
  answeredAt          DateTime        @default(now())
  quizSession         QuizSession     @relation(fields: [quizSessionId], references: [id], onDelete: Cascade)
  question            Question        @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedOption      QuestionOption? @relation("SelectedOption", fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([quizSessionId, questionId])
  @@index([questionId])
}

model UserQuestionStat {
  userId          String    @db.Uuid
  questionId      String    @db.Uuid
  attempts        Int       @default(0)
  correctAttempts Int       @default(0)
  lastAnsweredAt  DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question        Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
  @@index([questionId])
}

model TowerRock {
  id        String    @id @default(uuid()) @db.Uuid
  gameId    String    @db.Uuid
  round     Int
  throwerId String    @db.Uuid
  targetId  String    @db.Uuid
  createdAt DateTime  @default(now())
  game      TowerGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, round, throwerId])
  @@index([gameId, round, targetId])
}

enum CarciumaStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

// La Carciuma — five patrons around one wooden table. Every round serves one
// question; the worst answer (lowest score, slowest on a tie, silence counts as
// slowest) has to drink. Three drinks and that patron is under the table.
model CarciumaGame {
  id             String           @id @default(uuid()) @db.Uuid
  hostId         String           @db.Uuid
  status         CarciumaStatus   @default(WAITING)
  plan           Json
  currentRound   Int              @default(0)
  roundStartedAt DateTime?
  winnerSeat     Int?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  host           User             @relation("CarciumaHost", fields: [hostId], references: [id], onDelete: Cascade)
  players        CarciumaPlayer[]
  answers        CarciumaAnswer[]

  @@index([status, createdAt])
  @@index([hostId])
}

model CarciumaPlayer {
  id        String           @id @default(uuid()) @db.Uuid
  gameId    String           @db.Uuid
  userId    String?          @db.Uuid
  name      String           @db.VarChar(32)
  seat      Int
  isBot     Boolean          @default(false)
  drinks    Int              @default(0)
  passedOut Boolean          @default(false)
  outRound  Int?
  score     Int              @default(0)
  createdAt DateTime         @default(now())
  game      CarciumaGame     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user      User?            @relation("CarciumaSeats", fields: [userId], references: [id], onDelete: SetNull)
  answers   CarciumaAnswer[]

  @@unique([gameId, seat])
  @@index([userId])
}

model CarciumaAnswer {
  id                  String         @id @default(uuid()) @db.Uuid
  gameId              String         @db.Uuid
  playerId            String         @db.Uuid
  round               Int
  questionId          String         @db.Uuid
  selectedOptionId    String?        @db.Uuid
  answerText          String?  @db.VarChar(40)
  isCorrect           Boolean        @default(false)
  score               Int            @default(0)
  elapsedMilliseconds Int            @default(0)
  drank               Boolean        @default(false)
  createdAt           DateTime       @default(now())
  game                CarciumaGame   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player              CarciumaPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([gameId, round, playerId])
  @@index([gameId, round])
}
